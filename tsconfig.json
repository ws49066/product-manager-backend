{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["ES2024"],
        "module": "Node18",
        "paths": {
            "@/*": ["./src/*"]
        },
        "typeRoots": ["./src/types"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
    }
}